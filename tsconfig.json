{
    "compilerOptions": {
        "allowJs": false,
        "skipLibCheck": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "target": "es2022",
        "sourceMap": true,
        "outDir": "./.tmp/build/",
        "rootDir": ".",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "ignoreDeprecations": "5.0",
        "declaration": true,
        "lib": [
            "es2022",
            "dom"
        ]
    },
    "files": [
        "./src/visual.ts"
    ],
    "include": [
        "src/**/*.ts",
        "*.d.ts"
    ],
    "exclude": [
        ".tmp",
        "node_modules"
    ]
}